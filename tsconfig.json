{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./client/src/*"]
    }
  },
  "include": ["client/src/**/*.ts", "client/src/**/*.tsx", "shared/**/*.js", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
