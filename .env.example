# ECE Echo frontend
APP_URL=https://ece-feedback-system-bay.vercel.app

# Supabase is required for production persistence across browsers/devices.
# Vite exposes only VITE_* variables to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Keep service-role keys server-only. Never prefix them with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Express backend variables if you deploy the server separately.
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=
DATABASE_URL=
JWT_SECRET=change-this-long-random-secret-before-production
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD_HASH=
CSRF_SECRET=
UPLOAD_DIR=server/uploads
USE_LOCAL_JSON_FALLBACK=false
